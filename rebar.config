%% -*- mode: erlang -*-
%% can be simplified further once bear has been published to hex to simply the atom
%% 'bear'
{deps, [
        {bear, ".*", {git, "https://github.com/OpenRiak/bear", {branch, "openriak-3.6"}}}
       ]}.

{xref_checks,
 [undefined_function_calls,undefined_functions,
  locals_not_used,
  deprecated_function_calls, deprecated_functions]}.

{erl_opts, [debug_info]}.

{profiles,
 [{test,
   [{deps,
     [
      {meck, {git, "https://github.com/OpenRiak/meck.git", {branch, "openriak-3.6"}}},
      {proper, ".*", {git, "https://github.com/OpenRiak/proper", {branch, "openriak-3.6"}}}
     ]}]}]}.

{cover_enabled, true}.
